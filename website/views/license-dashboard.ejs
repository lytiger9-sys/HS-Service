<%- include('partials/head', { title }) %>
<body class="license-page">
  <main class="license-shell">
    <section class="license-hero license-card">
        <div class="hero-top">
          <div>
            <p class="eyebrow">License Administration</p>
            <h1>라이선스 관리</h1>
          </div>
          <form method="post" action="/license/logout" class="license-inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="ghost license-login-button" type="submit"><span>로그아웃</span></button>
          </form>
        </div>
      </section>

      <% if (issuedKeys && issuedKeys.length) { %>
        <section class="license-notice license-notice-success">
          <strong><%= issuedKeys.length %>개의 라이선스가 발급되었습니다.</strong>
          <p>라이선스 키는 평문으로 표시되며 아래 목록에서도 그대로 확인할 수 있습니다.</p>
          <% issuedKeys.forEach((key) => { %><code class="license-plain-key"><%= key %></code><% }) %>
        </section>
      <% } %>
      <% if (errorMessage) { %>
        <section class="license-notice license-notice-danger"><%= errorMessage %></section>
      <% } %>

      <section class="license-grid license-issue-grid">
        <article class="license-card">
          <p class="eyebrow">New License</p>
          <h2>라이선스 발급</h2>
          <form method="post" action="/license/issue" class="license-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label class="field">
              <span>플랜</span>
              <select name="plan">
                <option value="free">Free · 기본 기능</option>
                <option value="basic">Basic · 개인 서버 운영</option>
                <option value="standard">Standard · 성장 서버 운영</option>
                <option value="pro">Pro · 고급 관리 기능</option>
                <option value="enterprise">Enterprise · 전체 기능 및 확장 운영</option>
              </select>
            </label>
            <label class="field">
              <span>사용 기간(일)</span>
              <input type="number" name="durationDays" min="1" max="3650" value="30" required />
            </label>
            <label class="field">
              <span>생성 개수</span>
              <input type="number" name="count" min="1" max="100" value="1" required />
            </label>
            <button class="primary" type="submit">라이선스 발급</button>
          </form>
        </article>
      </section>

      <section class="license-card">
        <div class="section-head">
          <div>
            <p class="eyebrow">Maintenance Control</p>
            <h2>기능별 점검 모드</h2>
          </div>
        </div>
        <form method="post" action="/license/feature-control" class="license-form feature-control-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <p class="muted">토글을 끄면 해당 탭의 기능과 연결된 명령어·버튼이 서버 전체에서 일시 중지됩니다.</p>
          <div class="license-feature-grid">
            <% featureControls.forEach((feature) => { %>
              <label class="field toggle"><input type="checkbox" name="feature_<%= feature.id %>" value="on" <%= feature.banned ? '' : 'checked' %> /><span><%= feature.label %></span></label>
            <% }) %>
          </div>
          <label class="field toggle"><input type="checkbox" name="otherCommandsEnabled" value="on" <%= otherCommandsEnabled ? 'checked' : '' %> /><span>탭에 연결되지 않은 기타 명령어 허용</span></label>
          <button class="primary" type="submit">점검 모드 설정 저장</button>
        </form>
      </section>

      <section class="license-card">
        <div class="section-head">
          <div>
            <p class="eyebrow">Inventory</p>
            <h2>라이선스 목록</h2>
          </div>
          <span class="muted"><%= licenses.length %>개</span>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>키</th><th>플랜</th><th>기간</th><th>상태</th><th>서버</th><th>만료일</th><th>작업</th></tr></thead>
            <tbody>
              <% if (!licenses.length) { %>
                <tr><td colspan="7" class="muted">발급된 라이선스가 없습니다.</td></tr>
              <% } %>
              <% licenses.forEach((license) => { %>
                <tr>
                  <td><code class="license-plain-key"><%= license.key || `HS-••••-••••-${license.keyLast4}` %></code></td>
                  <td><%= license.plan %></td>
                  <td><%= license.durationDays %>일</td>
                  <td><span class="status-badge status-<%= license.status %>"><%= license.status %></span></td>
                  <td><%= license.assignedGuildId || '-' %></td>
                  <td><%= license.expiresAt ? new Date(license.expiresAt).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' }) : '-' %></td>
                  <td>
                    <% if (license.status === 'active') { %>
                      <form method="post" action="/license/<%= license._id %>/work-stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input type="hidden" name="stopped" value="<%= license.workStopped ? 'false' : 'true' %>" /><button class="ghost <%= license.workStopped ? '' : 'danger' %>" type="submit"><%= license.workStopped ? '작업재개' : '작업중지' %></button></form>
                    <% } %>
                    <% if (license.status === 'available' || license.status === 'active') { %>
                      <form method="post" action="/license/<%= license._id %>/revoke">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button class="ghost danger" type="submit">폐기</button>
                      </form>
                    <% } else { %>-<% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
  </main>
</body>
</html>
