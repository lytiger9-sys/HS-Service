<%- include('partials/head', { title }) %>
<body class="license-page">
  <main class="license-shell">
    <section class="license-hero license-card">
        <div class="hero-top">
          <div>
            <p class="eyebrow">License Administration</p>
            <h1>라이선스 관리</h1>
          </div>
          <form method="post" action="/license/logout" class="license-inline-form">
            <button class="ghost license-login-button" type="submit"><span>로그아웃</span></button>
          </form>
        </div>
      </section>

      <% if (issuedKeys && issuedKeys.length) { %>
        <section class="license-notice license-notice-success">
          <strong><%= issuedKeys.length %>개의 라이선스가 발급되었습니다.</strong>
          <p>라이선스 키는 평문으로 표시되며 아래 목록에서도 그대로 확인할 수 있습니다.</p>
          <% issuedKeys.forEach((key) => { %><code class="license-plain-key"><%= key %></code><% }) %>
        </section>
      <% } %>
      <% if (errorMessage) { %>
        <section class="license-notice license-notice-danger"><%= errorMessage %></section>
      <% } %>

      <section class="license-grid license-issue-grid">
        <article class="license-card">
          <p class="eyebrow">New License</p>
          <h2>라이선스 발급</h2>
          <form method="post" action="/license/issue" class="license-form">
            <label class="field">
              <span>플랜</span>
              <select name="plan">
                <option value="free">Free · 기본 기능</option>
                <option value="basic">Basic · 개인 서버 운영</option>
                <option value="standard">Standard · 성장 서버 운영</option>
                <option value="pro">Pro · 고급 관리 기능</option>
                <option value="enterprise">Enterprise · 전체 기능 및 확장 운영</option>
              </select>
            </label>
            <label class="field">
              <span>사용 기간(일)</span>
              <input type="number" name="durationDays" min="1" max="3650" value="30" required />
            </label>
            <label class="field">
              <span>생성 개수</span>
              <input type="number" name="count" min="1" max="100" value="1" required />
            </label>
            <button class="primary" type="submit">라이선스 발급</button>
          </form>
        </article>
      </section>

      <section class="license-card">
        <div class="section-head">
          <div>
            <p class="eyebrow">Maintenance Control</p>
            <h2>기능별 점검 모드</h2>
          </div>
        </div>
        <form method="post" action="/license/feature-control" class="license-form feature-control-form" data-toast-form="true">
          <p class="muted">토글을 끄면 해당 탭의 기능과 연결된 명령어·버튼이 서버 전체에서 일시 중지됩니다.</p>
          <div class="license-feature-grid">
            <% featureControls.forEach((feature) => { %>
              <label class="field toggle"><input type="checkbox" name="feature_<%= feature.id %>" value="on" <%= feature.banned ? '' : 'checked' %> /><span><%= feature.label %></span></label>
            <% }) %>
          </div>
          <label class="field toggle"><input type="checkbox" name="otherCommandsEnabled" value="on" <%= otherCommandsEnabled ? 'checked' : '' %> /><span>탭에 연결되지 않은 기타 명령어 허용</span></label>
          <button class="primary" type="submit">점검 모드 설정 저장</button>
        </form>
      </section>

      <section class="license-card">
        <div class="section-head">
          <div>
            <p class="eyebrow">Inventory</p>
            <h2>라이선스 목록</h2>
          </div>
          <span class="muted" data-license-count data-count="<%= licenses.length %>" data-total="<%= licenseTotal %>"><%= licenses.length %> / <%= licenseTotal %>개</span>
        </div>
        <form class="license-filter-bar" id="license-filter-form" method="get" action="/license/dashboard" data-license-search>
          <label class="field license-filter-search">
            <span>라이선스 검색</span>
            <input type="search" name="q" value="<%= licenseFilters.q %>" placeholder="키, 서버 ID, 플랜, 상태 검색" />
          </label>
          <label class="field">
            <span>플랜</span>
            <select name="plan">
              <option value="">전체 플랜</option>
              <option value="free" <%= licenseFilters.plan === 'free' ? 'selected' : '' %>>Free</option>
              <option value="basic" <%= licenseFilters.plan === 'basic' ? 'selected' : '' %>>Basic</option>
              <option value="standard" <%= licenseFilters.plan === 'standard' ? 'selected' : '' %>>Standard</option>
              <option value="pro" <%= licenseFilters.plan === 'pro' ? 'selected' : '' %>>Pro</option>
              <option value="enterprise" <%= licenseFilters.plan === 'enterprise' ? 'selected' : '' %>>Enterprise</option>
            </select>
          </label>
          <label class="field">
            <span>기간</span>
            <select name="period">
              <option value="">전체 기간</option>
              <option value="under7" <%= licenseFilters.period === 'under7' ? 'selected' : '' %>>7일 이하</option>
              <option value="8to30" <%= licenseFilters.period === '8to30' ? 'selected' : '' %>>8~30일</option>
              <option value="31to90" <%= licenseFilters.period === '31to90' ? 'selected' : '' %>>31~90일</option>
              <option value="over90" <%= licenseFilters.period === 'over90' ? 'selected' : '' %>>91일 이상</option>
            </select>
          </label>
          <label class="field">
            <span>상태</span>
            <select name="status">
              <option value="">전체 상태</option>
              <option value="available" <%= licenseFilters.status === 'available' ? 'selected' : '' %>>available</option>
              <option value="active" <%= licenseFilters.status === 'active' ? 'selected' : '' %>>active</option>
              <option value="expired" <%= licenseFilters.status === 'expired' ? 'selected' : '' %>>expired</option>
              <option value="revoked" <%= licenseFilters.status === 'revoked' ? 'selected' : '' %>>revoked</option>
            </select>
          </label>
          <div class="license-filter-actions">
            <button class="primary" type="submit">검색</button>
            <button class="ghost" type="button" data-license-export>엑셀로 다운로드</button>
          </div>
        </form>
        <div class="table-wrap">
          <table>
            <thead><tr><th>키</th><th>플랜</th><th>기간</th><th>상태</th><th>서버</th><th>만료일</th><th>작업</th></tr></thead>
            <tbody data-license-tbody>
              <% if (!licenses.length) { %>
                <tr><td colspan="7" class="muted"><%= licenseTotal ? '검색 조건에 맞는 라이선스가 없습니다.' : '발급된 라이선스가 없습니다.' %></td></tr>
              <% } %>
              <% licenses.forEach((license) => { %>
                <tr>
                  <td><code class="license-plain-key"><%= license.key || `HS-••••-••••-${license.keyLast4}` %></code></td>
                  <td><%= license.plan %></td>
                  <td><%= license.durationDays %>일</td>
                  <td><span class="status-badge status-<%= license.status %>"><%= license.status %></span></td>
                  <td><%= license.assignedGuildId || '-' %></td>
                  <td><%= license.expiresAt ? new Date(license.expiresAt).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' }) : '-' %></td>
                  <td>
                    <% if (license.status === 'active') { %>
                    <% } %>
                    <% if (license.status === 'available' || license.status === 'active') { %>
                      <form method="post" action="/license/<%= license._id %>/revoke">
                        <button class="ghost danger" type="submit">폐기</button>
                      </form>
                    <% } else { %>-<% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
  </main>
  <script>
    (() => {
      const form = document.querySelector('[data-license-search]');
      const exportButton = document.querySelector('[data-license-export]');
      const tbody = document.querySelector('[data-license-tbody]');
      const count = document.querySelector('[data-license-count]');
      const searchButton = form?.querySelector('button[type="submit"]');
      if (!form || !exportButton || !tbody || !count || !searchButton) return;

      const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (character) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
      }[character]));
      const formatDate = (value) => value ? new Date(value).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' }) : '-';
      const renderRows = (licenses) => {
        if (!licenses.length) return `<tr><td colspan="7" class="muted">검색 조건에 맞는 라이선스가 없습니다.</td></tr>`;
        return licenses.map((license) => `
          <tr>
            <td><code class="license-plain-key">${escapeHtml(license.key)}</code></td>
            <td>${escapeHtml(license.plan)}</td>
            <td>${escapeHtml(license.durationDays)}일</td>
            <td><span class="status-badge status-${escapeHtml(license.status)}">${escapeHtml(license.status)}</span></td>
            <td>${escapeHtml(license.assignedGuildId)}</td>
            <td>${escapeHtml(formatDate(license.expiresAt))}</td>
            <td>${license.canRevoke ? `<form method="post" action="/license/${encodeURIComponent(license.id)}/revoke"><button class="ghost danger" type="submit">폐기</button></form>` : '-'}</td>
          </tr>`).join('');
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const params = new URLSearchParams(new FormData(form));
        searchButton.disabled = true;
        searchButton.classList.add('is-loading');
        searchButton.dataset.originalLabel = searchButton.textContent;
        searchButton.textContent = '검색 중';
        try {
          const response = await fetch(`/license/licenses.json?${params.toString()}`, { headers: { Accept: 'application/json' } });
          const result = await response.json();
          if (!response.ok || !result.ok) throw new Error(result.message || '검색에 실패했습니다.');
          tbody.innerHTML = renderRows(result.licenses);
          count.textContent = `${result.count} / ${result.total}개`;
          count.dataset.count = result.count;
          count.dataset.total = result.total;
        } catch (error) {
          window.showSiteToast?.(error.message || '검색에 실패했습니다.', 'error');
        } finally {
          searchButton.disabled = false;
          searchButton.classList.remove('is-loading');
          searchButton.textContent = searchButton.dataset.originalLabel || '검색';
        }
      });

      exportButton.addEventListener('click', () => {
        const params = new URLSearchParams(new FormData(form));
        window.location.href = `/license/licenses.xlsx?${params.toString()}`;
      });

      window.addEventListener('license:changed', () => {
        form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
      });
    })();
  </script>
</body>
</html>
