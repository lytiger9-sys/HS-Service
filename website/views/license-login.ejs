<%- include('partials/head', { title }) %>
<body class="license-auth-page">
  <main class="license-auth-shell">
    <section class="license-auth-card">
      <p class="eyebrow">License Administration</p>
      <h1>라이선스 관리자</h1>
      <p class="muted">운영자 계정으로 로그인하면 라이선스를 발급하고 관리할 수 있습니다.</p>
      <% if (!configured) { %>
        <p class="notice danger">LICENSE_ADMIN_ID와 LICENSE_ADMIN_PASSWORD가 설정되지 않았습니다.</p>
      <% } %>
      <% if (message) { %>
        <p class="notice danger"><%= message %></p>
      <% } %>
      <form method="post" action="/license/login" class="license-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label class="field">
          <span>관리자 아이디</span>
          <input type="text" name="licenseAdminId" autocomplete="username" required />
        </label>
        <label class="field">
          <span>관리자 비밀번호</span>
          <input type="password" name="licenseAdminPassword" autocomplete="current-password" required />
        </label>
        <button class="primary license-login-button" type="submit" <%= configured ? '' : 'disabled' %>><span>로그인</span></button>
      </form>
      <a class="muted" href="/">일반 대시보드로 돌아가기</a>
    </section>
  </main>
</body>
</html>
