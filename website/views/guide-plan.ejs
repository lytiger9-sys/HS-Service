<%- include('partials/head', { title }) %>
<body class="guide-page guide-plan-detail-page">
  <header class="guide-nav">
    <a class="guide-brand" href="/guide">
      <span class="guide-brand-mark"><img src="/assets/HS.gif" alt="HS-Service 로고" /></span>
      <span><%= botName %> 가이드</span>
    </a>
    <nav class="guide-nav-links" aria-label="주요 메뉴">
      <a href="/guide">전체 가이드</a>
      <a href="/">메인으로</a>
    </nav>
  </header>

  <main class="guide-shell guide-plan-detail-shell guide-plan-copy-shell">
    <a class="guide-back-link" href="/guide">← 전체 플랜 보기</a>
    <section class="guide-plan-copy-hero">
      <p class="guide-kicker">PLAN <%= String(plan.order).padStart(2, "0") %> · HS-SERVICE</p>
      <h1><%= plan.label %></h1>
      <h2><%= plan.subtitle %></h2>
      <p class="guide-plan-copy-description"><%= plan.guideDescription %></p>
    </section>

    <section class="guide-detail-section">
      <div class="guide-section-heading">
        <div>
          <p class="guide-kicker">WHAT THIS PLAN ADDS</p>
          <h2>이 플랜에서 제공하는 기능</h2>
        </div>
        <p>서버 규모와 운영 방식에 맞춰 필요한 기능을 확인하세요.</p>
      </div>
      <div class="guide-detail-feature-list">
        <% plan.addedFeatures.forEach((feature) => { %>
          <article class="guide-detail-feature">
            <span class="guide-detail-feature-dot">·</span>
            <div>
              <h3><%= feature.label %></h3>
              <p><%= feature.description %></p>
            </div>
          </article>
        <% }) %>
        <% if (!plan.addedFeatures.length) { %>
          <article class="guide-detail-feature guide-detail-feature-empty">
            <span class="guide-detail-feature-dot">·</span>
            <div>
              <h3>기본 운영 시작</h3>
              <p>서버 운영에 필요한 기본 기능을 한곳에서 시작할 수 있습니다.</p>
            </div>
          </article>
        <% } %>
      </div>
    </section>

    <section class="guide-detail-section">
      <article class="guide-detail-panel guide-plan-access-panel">
        <p class="guide-kicker">DASHBOARD ACCESS</p>
        <h2>사용 가능한 대시보드 영역</h2>
        <p class="guide-detail-panel-intro">이 플랜에서 설정할 수 있는 서버 관리 영역입니다.</p>
        <div class="guide-detail-chip-list">
          <% plan.tabLabels.forEach((label) => { %>
            <span><%= label %></span>
          <% }) %>
        </div>
      </article>
    </section>

    <nav class="guide-plan-pager" aria-label="플랜 이동">
      <% if (previousPlan) { %><a href="/guide/<%= previousPlan.slug %>">← <%= previousPlan.label %></a><% } else { %><span></span><% } %>
      <a class="guide-plan-pager-center" href="/guide">전체 플랜</a>
      <% if (nextPlan) { %><a href="/guide/<%= nextPlan.slug %>"><%= nextPlan.label %> →</a><% } else { %><span></span><% } %>
    </nav>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
