<%- include('partials/head', { title }) %>
<body class="guide-page guide-home-page">
  <header class="guide-nav">
    <a class="guide-brand" href="/">
      <span class="guide-brand-mark">HS</span>
      <span><%= botName %></span>
    </a>
    <nav class="guide-nav-links" aria-label="주요 메뉴">
      <a href="/">메인으로</a>
      <% if (currentUser) { %>
        <a class="guide-nav-button" href="/">대시보드</a>
      <% } else { %>
        <a class="guide-nav-button" href="/auth/discord">Discord 로그인</a>
      <% } %>
    </nav>
  </header>

  <main class="guide-shell guide-home-shell">
    <h1 class="guide-brand-wordmark">HS-Service</h1>
    <section class="guide-plan-section" id="plans" aria-label="서비스 플랜">
      <div class="guide-plan-grid guide-plan-grid-interactive">
        <% plans.forEach((plan) => { %>
          <a class="guide-plan-card guide-plan-card-interactive" href="/guide/<%= plan.slug %>">
            <span class="guide-plan-card-topline">
              <span class="guide-plan-order">0<%= plan.order %></span>
              <span class="guide-plan-arrow" aria-hidden="true">↗</span>
            </span>
            <span class="guide-plan-title"><%= plan.label %></span>
            <span class="guide-plan-price"><%= plan.price %></span>
            <span class="guide-plan-audience"><%= plan.audience %></span>
            <span class="guide-plan-card-hint">플랜 상세 보기</span>
          </a>
        <% }) %>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
