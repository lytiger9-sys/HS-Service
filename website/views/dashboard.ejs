<%- include('partials/head', { title: `${botName} Dashboard` }) %>
<body class="dashboard-page">
  <div class="app-shell">
    <%- include('partials/sidebar', { botName, guild, sections, activeSection, currentUser }) %>

    <main class="content">
      <% const panelClass = (panel) => `dashboard-panel${activeSection === panel ? '' : ' is-hidden'}`; %>
      <% if (saved) { %>
        <div class="flash">변경 사항이 저장되었습니다.</div>
      <% } %>

      <section class="<%= panelClass('overview') %>" data-panel="overview">
        <section class="hero card">
        <div>
          <p class="eyebrow">Server Control</p>
          <h2><%= guild.name %></h2>
          <p class="muted">서버 정보, 자동 환영, 보안, 티켓, 투표, 로그 설정을 한곳에서 관리합니다.</p>
        </div>
        <div class="hero-grid">
          <div class="metric">
            <span>전체 인원</span>
            <strong><%= overview.totalMembers %></strong>
          </div>
          <div class="metric">
            <span>사람</span>
            <strong><%= overview.humans %></strong>
          </div>
          <div class="metric">
            <span>봇</span>
            <strong><%= overview.bots %></strong>
          </div>
          <div class="metric">
            <span>관리자</span>
            <strong><%= overview.adminCount %></strong>
          </div>
          <div class="metric">
            <span>활성 투표</span>
            <strong><%= overview.activePolls.length %></strong>
          </div>
        </div>
        </section>

        <section class="grid two-up">
        <article class="card" data-section="overview">
          <h3>최근 개요</h3>
          <dl class="key-list">
            <div><dt>채널</dt><dd><%= overview.channels %>개</dd></div>
            <div><dt>역할</dt><dd><%= overview.roles %>개</dd></div>
            <div><dt>티켓</dt><dd><%= overview.activeTickets.length %>개</dd></div>
            <div><dt>임시 음성</dt><dd><%= overview.tempChannels.length %>개</dd></div>
          </dl>
        </article>

        <article class="card" data-section="overview">
          <h3>최근 기록</h3>
          <div class="stack">
            <% (overview.recentNotes || []).slice(0, 3).forEach((note) => { %>
              <div class="mini-item">
                <strong><%= note.title %></strong>
                <span><%= formatDate(note.createdAt) %></span>
              </div>
            <% }) %>
            <% if (!(overview.recentNotes || []).length) { %>
              <p class="muted">저장된 내용이 없습니다.</p>
            <% } %>
          </div>
        </article>
        </section>

        <%- include('partials/server-status-panel', { overview, formatDate }) %>
      </section>

      <section class="panel-stack <%= panelClass('administrators') %>" data-panel="administrators">
        <%- include('partials/admins-panel', { administrators, formatDate }) %>
      </section>

      <section class="panel-stack <%= panelClass('welcome') %>" data-panel="welcome">
        <article class="card section-panel">
          <div class="section-head">
            <div>
              <p class="eyebrow">Welcome</p>
              <h3>환영 메시지</h3>
            </div>
            <p class="muted">신규 입장 시 채널 임베드와 DM을 분리해서 보냅니다.</p>
          </div>

          <form class="settings-form" method="post" action="/guild/<%= guild.id %>/settings/welcome">
            <div class="form-grid">
              <label class="field toggle">
                <input type="checkbox" name="welcomeEnabled" <%= settings.welcome.enabled ? 'checked' : '' %> />
                <span>환영 기능 활성화</span>
              </label>
              <label class="field">
                <span>환영 채널</span>
                <select name="welcomeChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.welcome.channelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>DM 실패 알림 채널</span>
                <select name="welcomeErrorChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.welcome.errorChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>채널 임베드 제목</span>
                <input type="text" name="welcomeEmbedTitle" value="<%= settings.welcome.embedTitle %>" data-welcome-preview="title" />
              </label>
              <label class="field full">
                <span>채널 임베드 내용</span>
                <textarea name="welcomeEmbedDescription" rows="4" data-welcome-preview="description"><%= settings.welcome.embedDescription %></textarea>
              </label>
              <label class="field">
                <span>채널 임베드 색상</span>
                <input type="color" name="welcomeEmbedColor" value="<%= settings.welcome.embedColor %>" data-welcome-preview="color" />
              </label>
              <label class="field">
                <span>DM 제목</span>
                <input type="text" name="welcomeDmTitle" value="<%= settings.welcome.dmTitle %>" data-welcome-preview="dmTitle" />
              </label>
              <label class="field full">
                <span>DM 내용</span>
                <textarea name="welcomeDmMessage" rows="4" data-welcome-preview="dmMessage"><%= settings.welcome.dmMessage %></textarea>
              </label>
              <label class="field">
                <span>DM 색상</span>
                <input type="color" name="welcomeDmColor" value="<%= settings.welcome.dmColor %>" data-welcome-preview="dmColor" />
              </label>
            </div>
            <button class="primary" type="submit">저장</button>
          </form>
        </article>

        <aside class="preview-column">
          <div class="card">
            <div class="section-head compact">
              <div>
                <p class="eyebrow">Live Preview</p>
                <h3>환영 임베드</h3>
              </div>
            </div>
            <div class="discord-preview" id="welcome-preview">
              <div class="preview-bar"></div>
              <div class="preview-body">
                <h4 data-preview-title><%= settings.welcome.embedTitle %></h4>
                <p data-preview-description><%= settings.welcome.embedDescription %></p>
                <div class="preview-footer">
                  <span data-preview-footer><%= guild.name %></span>
                  <span data-preview-time>방금 전</span>
                </div>
              </div>
            </div>
            <div class="discord-preview dm-preview">
              <div class="preview-bar preview-bar-dm"></div>
              <div class="preview-body">
                <h4 data-preview-dm-title><%= settings.welcome.dmTitle %></h4>
                <p data-preview-dm-message><%= settings.welcome.dmMessage %></p>
              </div>
            </div>
          </div>
        </aside>
      </section>

      <section class="panel-stack <%= panelClass('ticket') %>" data-panel="ticket">
        <article class="card section-panel">
          <div class="section-head">
            <div>
              <p class="eyebrow">Ticket</p>
              <h3>티켓 설정</h3>
            </div>
            <p class="muted">관리자만 티켓을 열고 닫습니다. 카테고리와 로그 채널을 지정하세요.</p>
          </div>

          <form class="settings-form" method="post" action="/guild/<%= guild.id %>/settings/ticket">
            <div class="form-grid">
              <label class="field toggle">
                <input type="checkbox" name="ticketEnabled" <%= settings.ticket.enabled ? 'checked' : '' %> />
                <span>티켓 기능 활성화</span>
              </label>
              <label class="field">
                <span>티켓 카테고리</span>
                <select name="ticketCategoryId">
                  <option value="">선택 안 함</option>
                  <% channels.categories.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.ticket.categoryId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>티켓 로그 채널</span>
                <select name="ticketLogChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.ticket.logChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>채널 접두사</span>
                <input type="text" name="ticketPrefix" value="<%= settings.ticket.channelPrefix %>" />
              </label>
            </div>
            <button class="primary" type="submit">저장</button>
          </form>
        </article>
      </section>

      <section class="panel-stack <%= panelClass('security') %>" data-panel="security">
        <article class="card section-panel">
          <div class="section-head">
            <div>
              <p class="eyebrow">Security</p>
              <h3>보안 규칙</h3>
            </div>
            <p class="muted">전체 멘션, 도배, 욕설, 초대 링크를 각각 타임아웃 처리합니다.</p>
          </div>

          <form class="settings-form" method="post" action="/guild/<%= guild.id %>/settings/security">
            <div class="form-grid">
              <label class="field">
                <span>전체 멘션 타임아웃(분)</span>
                <input type="number" min="0" name="massMentionTimeoutMinutes" value="<%= settings.security.massMentionTimeoutMinutes %>" />
              </label>
              <label class="field">
                <span>도배 타임아웃(분)</span>
                <input type="number" min="0" name="spamTimeoutMinutes" value="<%= settings.security.spamTimeoutMinutes %>" />
              </label>
              <label class="field">
                <span>욕설 타임아웃(분)</span>
                <input type="number" min="0" name="profanityTimeoutMinutes" value="<%= settings.security.profanityTimeoutMinutes %>" />
              </label>
              <label class="field">
                <span>초대 링크 타임아웃(분)</span>
                <input type="number" min="0" name="inviteTimeoutMinutes" value="<%= settings.security.inviteTimeoutMinutes %>" />
              </label>
              <label class="field">
                <span>도배 감지 창(초)</span>
                <input type="number" min="1" name="spamWindowSeconds" value="<%= settings.security.spamWindowSeconds %>" />
              </label>
              <label class="field">
                <span>도배 반복 기준</span>
                <input type="number" min="2" name="spamRepeatThreshold" value="<%= settings.security.spamRepeatThreshold %>" />
              </label>
              <label class="field full">
                <span>욕설 목록</span>
                <textarea name="profanityWords" rows="4"><%= (settings.security.profanityWords || []).join('\n') %></textarea>
              </label>
            </div>
            <button class="primary" type="submit">저장</button>
          </form>
        </article>
      </section>

      <section class="panel-stack <%= panelClass('assignment') %>" data-panel="assignment">
        <article class="card section-panel">
          <div class="section-head">
            <div>
              <p class="eyebrow">Role Assignment</p>
              <h3>메시지 역할 지급</h3>
            </div>
            <p class="muted">지정한 채널에 글을 남긴 사용자에게 역할을 자동으로 부여합니다.</p>
          </div>

          <form class="settings-form" method="post" action="/guild/<%= guild.id %>/settings/assignment">
            <div class="form-grid">
              <label class="field">
                <span>대상 채널</span>
                <select name="assignmentChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.assignment.channelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>부여 역할</span>
                <select name="assignmentRoleId">
                  <option value="">선택 안 함</option>
                  <% roles.forEach((role) => { %>
                    <option value="<%= role.id %>" <%= settings.assignment.roleId === role.id ? 'selected' : '' %>><%= role.label %></option>
                  <% }) %>
                </select>
              </label>
            </div>
            <button class="primary" type="submit">저장</button>
          </form>
        </article>
      </section>

      <section class="panel-stack <%= panelClass('voice') %>" data-panel="voice">
        <article class="card section-panel">
          <div class="section-head">
            <div>
              <p class="eyebrow">Voice</p>
              <h3>임시 음성 채널</h3>
            </div>
            <p class="muted">간단한 명령으로 생성되는 임시 음성 채널의 위치를 지정합니다.</p>
          </div>

          <form class="settings-form" method="post" action="/guild/<%= guild.id %>/settings/voice">
            <div class="form-grid">
              <label class="field">
                <span>카테고리</span>
                <select name="voiceCategoryId">
                  <option value="">선택 안 함</option>
                  <% channels.categories.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.voice.categoryId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>기본 이름</span>
                <input type="text" name="voiceDefaultName" value="<%= settings.voice.defaultName %>" />
              </label>
              <label class="field">
                <span>최대 인원</span>
                <input type="number" min="0" name="voiceMaxUsers" value="<%= settings.voice.maxUsers %>" />
              </label>
            </div>
            <button class="primary" type="submit">저장</button>
          </form>
        </article>
      </section>

      <section class="panel-stack <%= panelClass('honeypot') %>" data-panel="honeypot">
        <article class="card section-panel">
          <div class="section-head">
            <div>
              <p class="eyebrow">Honeypot</p>
              <h3>허니팟 채널</h3>
            </div>
            <p class="muted">지정 채널 발언자를 추방하고 적발 수를 표시합니다. 현재 적발: <strong><%= settings.honeypot.caughtCount %></strong></p>
          </div>

          <form class="settings-form" method="post" action="/guild/<%= guild.id %>/settings/honeypot">
            <div class="form-grid">
              <label class="field">
                <span>허니팟 채널</span>
                <select name="honeypotChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.honeypot.channelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>허니팟 로그 채널</span>
                <select name="honeypotLogChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.honeypot.logChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
            </div>
            <button class="primary" type="submit">저장</button>
          </form>
        </article>
      </section>

      <section class="panel-stack <%= panelClass('notice') %>" data-panel="notice">
        <article class="card section-panel">
          <div class="section-head">
            <div>
              <p class="eyebrow">Notice</p>
              <h3>서버 공지</h3>
            </div>
            <p class="muted">/notice 명령에 표시할 서버 안내 문구를 저장합니다.</p>
          </div>

          <form class="settings-form" method="post" action="/guild/<%= guild.id %>/settings/notice">
            <div class="form-grid">
              <label class="field full">
                <span>공지 내용</span>
                <textarea name="noticeContent" rows="6"><%= settings.notice.content %></textarea>
              </label>
            </div>
            <button class="primary" type="submit">저장</button>
          </form>
        </article>
      </section>

      <section class="panel-stack <%= panelClass('polls') %>" data-panel="polls">
        <article class="card section-panel">
          <div class="section-head">
            <div>
              <p class="eyebrow">Polls</p>
              <h3>투표 생성</h3>
            </div>
            <p class="muted">마지막 항목을 자유 입력으로 바꿔 버튼형 투표를 게시합니다.</p>
          </div>

          <form class="settings-form" method="post" action="/guild/<%= guild.id %>/polls">
            <div class="form-grid">
              <label class="field">
                <span>게시 채널</span>
                <select name="pollChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>"><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>질문</span>
                <input type="text" name="pollQuestion" data-poll-preview="question" />
              </label>
              <label class="field full">
                <span>설명</span>
                <textarea name="pollDescription" rows="4" data-poll-preview="description"></textarea>
              </label>
              <label class="field full">
                <span>항목(한 줄에 하나, 마지막 줄은 자유 입력 항목으로 사용 가능)</span>
                <textarea name="pollOptions" rows="5" data-poll-preview="options"></textarea>
              </label>
              <label class="field toggle">
                <input type="checkbox" name="pollFreeText" checked data-poll-preview="freeText" />
                <span>마지막 항목 자유 입력</span>
              </label>
            </div>
            <button class="primary" type="submit">게시</button>
          </form>
        </article>

        <aside class="preview-column">
          <div class="card">
            <div class="section-head compact">
              <div>
                <p class="eyebrow">Live Preview</p>
                <h3>투표 미리보기</h3>
              </div>
            </div>
            <div class="discord-preview" id="poll-preview">
              <div class="preview-bar preview-bar-poll"></div>
              <div class="preview-body">
                <h4 data-preview-question>투표 질문</h4>
                <p data-preview-poll-description>설명이 표시됩니다.</p>
                <div class="poll-options" data-preview-options>
                  <span>항목이 여기에 표시됩니다.</span>
                </div>
              </div>
            </div>
          </div>
        </aside>
      </section>

      <section class="panel-stack <%= panelClass('logs') %>" data-panel="logs">
        <article class="card section-panel">
          <div class="section-head">
            <div>
              <p class="eyebrow">Logs</p>
              <h3>로그 채널</h3>
            </div>
            <p class="muted">환영, 티켓, 보안, 서버, 투표, 시스템 로그를 각각 분리할 수 있습니다.</p>
          </div>

          <form class="settings-form" method="post" action="/guild/<%= guild.id %>/settings/logs">
            <div class="form-grid">
              <label class="field">
                <span>환영 로그</span>
                <select name="logWelcomeChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.logs.welcomeChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>티켓 로그</span>
                <select name="logTicketChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.logs.ticketChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>모더레이션 로그</span>
                <select name="logModerationChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.logs.moderationChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>보안 로그</span>
                <select name="logSecurityChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.logs.securityChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>서버 로그</span>
                <select name="logServerChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.logs.serverChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>투표 로그</span>
                <select name="logVoteChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.logs.voteChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>시스템 로그</span>
                <select name="logSystemChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.logs.systemChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
            </div>
            <button class="primary" type="submit">저장</button>
          </form>
        </article>
      </section>

    </main>
  </div>

  <%- include('partials/footer') %>
