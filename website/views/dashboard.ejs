<%- include('partials/head', { title: `${botName} Dashboard` }) %>
<body class="dashboard-page">
  <div class="app-shell">
    <%- include('partials/sidebar', { botName, guild, sections, activeSection, currentUser }) %>

    <main class="content">
      <% const panelClass = (panel) => `dashboard-panel${activeSection === panel ? '' : ' is-hidden'}`; %>
      <div class="save-toast" data-save-toast hidden aria-live="polite"></div>

      <section class="<%= panelClass('overview') %>" data-panel="overview">
        <section class="hero card">
        <div class="hero-top">
          <div>
            <p class="eyebrow">Server Control</p>
            <h2><%= guild.name %></h2>
            <p class="muted">서버 정보, 자동 환영, 보안, 티켓, 관리자 상태, 투표, 로그 설정을 한곳에서 관리합니다.</p>
          </div>
          <form class="hero-reset" method="post" action="/guild/<%= guild.id %>/reset" data-reset-form data-confirm-reset="true" data-confirm-message="이 서버의 데이터를 기본값으로 초기화할까요?">
            <button class="ghost danger" type="submit">DB 초기화</button>
          </form>
        </div>
        <div class="hero-grid">
          <div class="metric">
            <span>전체 인원</span>
            <strong><%= overview.totalMembers %></strong>
          </div>
          <div class="metric">
            <span>사람</span>
            <strong><%= overview.humans %></strong>
          </div>
          <div class="metric">
            <span>봇</span>
            <strong><%= overview.bots %></strong>
          </div>
          <div class="metric">
            <span>관리자</span>
            <strong><%= overview.adminCount %></strong>
          </div>
          <div class="metric">
            <span>활성 투표</span>
            <strong><%= overview.activePolls.length %></strong>
          </div>
        </div>
        </section>

        <section class="grid two-up">
        <article class="card" data-section="overview">
          <h3>최근 개요</h3>
            <dl class="key-list">
            <div><dt>채널</dt><dd><%= overview.channels %>개</dd></div>
            <div><dt>역할</dt><dd><%= overview.roles %>개</dd></div>
            <div><dt>임시 음성</dt><dd><%= overview.tempChannels.length %>개</dd></div>
            <div><dt>활성 투표</dt><dd><%= (overview.activePolls || []).length %>개</dd></div>
          </dl>
        </article>

        <article class="card" data-section="overview">
          <h3>최근 제재</h3>
          <div class="stack">
            <% const recentPunishments = overview.recentPunishments || []; %>
            <% recentPunishments.slice(0, 5).forEach((entry) => { %>
              <div class="mini-item">
                <strong><%= entry.memberTag || entry.memberId || "알 수 없음" %></strong>
                <span><%= entry.type %> · <%= formatDate(entry.createdAt) %></span>
              </div>
            <% }) %>
            <% if (!recentPunishments.length) { %>
              <p class="muted">최근 제재 기록이 없습니다.</p>
            <% } %>
          </div>
        </article>
        </section>
      </section>

      <section class="panel-stack <%= panelClass('administrators') %>" data-panel="administrators">
        <%- include('partials/admins-panel', { administrators, staffMembers, formatDate }) %>
        <%- include('partials/staff-panel', { guild, channels, settings, staffMembers, staffCounts, formatDate }) %>
      </section>

      <section class="panel-stack <%= panelClass('welcome') %>" data-panel="welcome">
        <article class="card section-panel">
          <div class="section-head">
            <div>
              <p class="eyebrow">Welcome</p>
              <h3>환영 메시지</h3>
            </div>
            <label class="field toggle section-toggle">
              <input type="checkbox" form="welcome-settings-form" name="welcomeEnabled" <%= settings.welcome.enabled ? 'checked' : '' %> />
              <span>환영 기능 활성화</span>
            </label>
          </div>

          <form class="settings-form" id="welcome-settings-form" method="post" action="/guild/<%= guild.id %>/settings/welcome">
            <div class="form-grid">
              <label class="field">
                <span>환영 채널</span>
                <select name="welcomeChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.welcome.channelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>DM 실패 알림 채널</span>
                <select name="welcomeErrorChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.welcome.errorChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>채널 임베드 제목</span>
                <input type="text" name="welcomeEmbedTitle" value="<%= settings.welcome.embedTitle %>" data-welcome-preview="title" />
                <div class="welcome-variable-buttons" data-variable-target="welcomeEmbedTitle"><button type="button" class="ghost variable-button" data-variable="{user}">유저</button><button type="button" class="ghost variable-button" data-variable="{guild}">길드</button><button type="button" class="ghost variable-button" data-variable="{totalmember}">총멤버</button></div>
              </label>
              <label class="field full">
                <span>채널 임베드 내용</span>
                <textarea name="welcomeEmbedDescription" rows="4" data-welcome-preview="description"><%= settings.welcome.embedDescription %></textarea>
                <div class="welcome-variable-buttons" data-variable-target="welcomeEmbedDescription"><button type="button" class="ghost variable-button" data-variable="{user}">유저</button><button type="button" class="ghost variable-button" data-variable="{guild}">길드</button><button type="button" class="ghost variable-button" data-variable="{totalmember}">총멤버</button></div>
              </label>
              <label class="field">
                <span>채널 임베드 색상</span>
                <input type="color" name="welcomeEmbedColor" value="<%= settings.welcome.embedColor %>" data-welcome-preview="color" />
              </label>
              <label class="field">
                <span>DM 제목</span>
                <input type="text" name="welcomeDmTitle" value="<%= settings.welcome.dmTitle %>" data-welcome-preview="dmTitle" />
                <div class="welcome-variable-buttons" data-variable-target="welcomeDmTitle"><button type="button" class="ghost variable-button" data-variable="{user}">유저</button><button type="button" class="ghost variable-button" data-variable="{guild}">길드</button><button type="button" class="ghost variable-button" data-variable="{totalmember}">총멤버</button></div>
              </label>
              <label class="field full">
                <span>DM 내용</span>
                <textarea name="welcomeDmMessage" rows="4" data-welcome-preview="dmMessage"><%= settings.welcome.dmMessage %></textarea>
                <div class="welcome-variable-buttons" data-variable-target="welcomeDmMessage"><button type="button" class="ghost variable-button" data-variable="{user}">유저</button><button type="button" class="ghost variable-button" data-variable="{guild}">길드</button><button type="button" class="ghost variable-button" data-variable="{totalmember}">총멤버</button></div>
              </label>
              <label class="field">
                <span>DM 색상</span>
                <input type="color" name="welcomeDmColor" value="<%= settings.welcome.dmColor %>" data-welcome-preview="dmColor" />
              </label>
            </div>
            <button class="primary" type="submit">저장</button>
          </form>
        </article>

      </section>

      <%- include('partials/ticket-panel', { guild, channels, settings, panelClass }) %>

      <section class="panel-stack <%= panelClass('security') %>" data-panel="security">
        <article class="card section-panel">
          <div class="section-head">
            <div>
              <p class="eyebrow">Security</p>
              <h3>보안 규칙</h3>
            </div>
            <label class="field toggle section-toggle">
              <input type="checkbox" form="security-settings-form" name="securityEnabled" <%= settings.security.enabled !== false ? 'checked' : '' %> />
              <span>보안 기능 활성화</span>
            </label>
          </div>

          <form class="settings-form" id="security-settings-form" method="post" action="/guild/<%= guild.id %>/settings/security">
            <div class="form-grid">
              <label class="field full">
                <span>보안 로그 채널</span>
                <select name="securityLogChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %><option value="<%= channel.id %>" <%= settings.security.securityLogChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option><% }) %>
                </select>
              </label>
              <label class="field">
                <span>전체 멘션 타임아웃(분)</span>
                <input type="number" min="0" name="massMentionTimeoutMinutes" value="<%= settings.security.massMentionTimeoutMinutes %>" />
              </label>
              <label class="field">
                <span>도배 타임아웃(분)</span>
                <input type="number" min="0" name="spamTimeoutMinutes" value="<%= settings.security.spamTimeoutMinutes %>" />
              </label>
              <label class="field">
                <span>욕설 타임아웃(분)</span>
                <input type="number" min="0" name="profanityTimeoutMinutes" value="<%= settings.security.profanityTimeoutMinutes %>" />
              </label>
              <label class="field">
                <span>초대 링크 타임아웃(초)</span>
                <input type="number" min="0" name="inviteTimeoutSeconds" value="<%= settings.security.inviteTimeoutSeconds %>" />
              </label>
              <label class="field">
                <span>도배 반복 기준</span>
                <input type="number" min="2" name="spamRepeatThreshold" value="<%= settings.security.spamRepeatThreshold %>" />
              </label>
              <label class="field full">
                <span>욕설 목록</span>
                <textarea name="profanityWords" rows="4"><%= (settings.security.profanityWords || []).join('\n') %></textarea>
              </label>
            </div>
            <button class="primary" type="submit">저장</button>
          </form>
        </article>
      </section>

      <section class="panel-stack <%= panelClass('assignment') %>" data-panel="assignment">
        <article class="card section-panel">
          <div class="section-head">
            <div>
              <p class="eyebrow">Role Assignment</p>
              <h3>메시지 역할 지급</h3>
            </div>
            <label class="field toggle section-toggle">
              <input type="checkbox" form="assignment-settings-form" name="assignmentEnabled" <%= settings.assignment.enabled !== false ? 'checked' : '' %> />
              <span>할당 기능 활성화</span>
            </label>
          </div>

          <form class="settings-form" id="assignment-settings-form" method="post" action="/guild/<%= guild.id %>/settings/assignment">
            <div class="form-grid">
              <label class="field">
                <span>대상 채널</span>
                <select name="assignmentChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.assignment.channelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>부여 역할</span>
                <select name="assignmentRoleId">
                  <option value="">선택 안 함</option>
                  <% roles.forEach((role) => { %>
                    <option value="<%= role.id %>" <%= settings.assignment.roleId === role.id ? 'selected' : '' %>><%= role.label %></option>
                  <% }) %>
                </select>
              </label>
            </div>
            <button class="primary" type="submit">저장</button>
          </form>
        </article>
      </section>

      <section class="panel-stack <%= panelClass('voice') %>" data-panel="voice">
        <article class="card section-panel">
          <div class="section-head">
            <div>
              <p class="eyebrow">Voice</p>
              <h3>임시 음성 채널</h3>
            </div>
            <label class="field toggle section-toggle">
              <input type="checkbox" form="voice-settings-form" name="voiceEnabled" <%= settings.voice.enabled !== false ? 'checked' : '' %> />
              <span>음성 기능 활성화</span>
            </label>
          </div>

          <form class="settings-form" id="voice-settings-form" method="post" action="/guild/<%= guild.id %>/settings/voice">
            <div class="form-grid">
              <label class="field">
                <span>카테고리</span>
                <select name="voiceCategoryId">
                  <option value="">선택 안 함</option>
                  <% channels.categories.forEach((channel) => { %>
                    <option value="<%= channel.id %>" <%= settings.voice.categoryId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>기본 이름</span>
                <input type="text" name="voiceDefaultName" value="<%= settings.voice.defaultName %>" />
              </label>
              <label class="field">
                <span>최대 인원</span>
                <input type="number" min="0" name="voiceMaxUsers" value="<%= settings.voice.maxUsers %>" />
              </label>
            </div>
            <button class="primary" type="submit">저장</button>
          </form>
        </article>
      </section>


            <%- include('partials/embed-panel', { guild, channels, roles, settings, panelClass }) %>

      <section class="panel-stack <%= panelClass('polls') %>" data-panel="polls">
        <article class="card section-panel">
          <div class="section-head">
            <div>
              <p class="eyebrow">Polls</p>
              <h3>투표 생성</h3>
            </div>
            <label class="field toggle section-toggle">
              <input type="checkbox" form="poll-publish-form" name="pollsEnabled" <%= settings.polls.enabled !== false ? 'checked' : '' %> />
              <span>투표 기능 활성화</span>
            </label>
          </div>

          <form class="settings-form" id="poll-publish-form" method="post" action="/guild/<%= guild.id %>/settings/polls">
            <div class="form-grid">
              <label class="field">
                <span>게시 채널</span>
                <select name="pollChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %>
                    <option value="<%= channel.id %>"><%= channel.label %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field">
                <span>투표 로그 채널</span>
                <select name="pollVoteLogChannelId">
                  <option value="">선택 안 함</option>
                  <% channels.text.forEach((channel) => { %><option value="<%= channel.id %>" <%= settings.polls.voteLogChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option><% }) %>
                </select>
              </label>
              <label class="field">
                <span>질문</span>
                <input type="text" name="pollQuestion" data-poll-preview="question" />
              </label>
              <label class="field">
                <span>투표 만료 일수</span>
                <input type="number" name="pollExpirationDays" min="1" max="365" value="<%= settings.polls.expirationDays || 7 %>" />
              </label>
              <label class="field full">
                <span>설명</span>
                <textarea name="pollDescription" rows="4" data-poll-preview="description"></textarea>
              </label>
              <label class="field full">
                <span>항목(한 줄에 하나, 자유 입력을 켜면 별도 항목이 추가됩니다)</span>
                <textarea name="pollOptions" rows="5" data-poll-preview="options"></textarea>
              </label>
              <label class="field toggle">
                <input type="checkbox" name="pollFreeText" checked data-poll-preview="freeText" />
                <span>자유 입력 항목 추가</span>
              </label>
              <label class="field">
                <span>결과 표시</span>
                <select name="pollResultVisibility">
                  <option value="public" <%= (settings.polls.resultVisibility || 'public') !== 'private' ? 'selected' : '' %>>공개 결과</option>
                  <option value="private" <%= settings.polls.resultVisibility === 'private' ? 'selected' : '' %>>비공개 결과</option>
                </select>
              </label>
            </div>
          </form>
          <div class="poll-settings-actions">
            <button class="primary" type="submit" formaction="/guild/<%= guild.id %>/settings/polls">저장</button>
            <button class="ghost" type="submit" formaction="/guild/<%= guild.id %>/polls">게시</button>
          </div>
        </article>

        <article class="card section-panel poll-management-card">
          <div class="section-head">
            <div>
              <p class="eyebrow">Active Polls</p>
              <h3>현재 진행 중인 투표</h3>
              <p class="muted">게시된 투표를 즉시 중지하거나 같은 설정으로 다시 게시·삭제할 수 있습니다.</p>
            </div>
          </div>
          <% const activePolls = (polls || []).filter((poll) => !poll.expired); %>
          <% if (activePolls.length) { %>
            <div class="table-wrap">
              <table class="data-table">
                <thead><tr><th>질문</th><th>게시 채널</th><th>만료</th><th>현재 득표</th><th>관리</th></tr></thead>
                <tbody>
                  <% activePolls.forEach((poll) => { %>
                    <tr>
                      <td><strong><%= poll.question %></strong></td>
                      <td><%= poll.channelId ? `#${channels.text.find((channel) => channel.id === poll.channelId)?.name || poll.channelId}` : '없음' %></td>
                      <td><%= formatDate(poll.expiresAt) %></td>
                      <td><%= (poll.options || []).reduce((total, option) => total + Number(option.count || 0), 0) %>표</td>
                      <td>
                        <div class="poll-action-group" role="group" aria-label="투표 관리">
                          <form method="post" action="/guild/<%= guild.id %>/polls/<%= poll.id %>/stop"><button class="poll-action poll-action-stop" type="submit"><span aria-hidden="true">Ⅱ</span><span>중지</span></button></form>
                          <form method="post" action="/guild/<%= guild.id %>/polls/<%= poll.id %>/republish"><button class="poll-action poll-action-republish" type="submit"><span aria-hidden="true">↻</span><span>재게시</span></button></form>
                          <form method="post" action="/guild/<%= guild.id %>/polls/<%= poll.id %>/delete" onsubmit="return confirm('이 투표와 게시 메시지를 삭제할까요?');"><button class="poll-action poll-action-delete" type="submit"><span aria-hidden="true">×</span><span>삭제</span></button></form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p class="muted">현재 진행 중인 투표가 없습니다.</p>
          <% } %>
        </article>

      </section>

      <%- include('partials/logs-panel', { guild, channels, settings, panelClass }) %>
      <%- include('partials/nickname-panel', { guild, roles, settings, panelClass }) %>
      <%- include('partials/shop-panel', { guild, channels, shop, panelClass }) %>
      <%- include('partials/partner-panel', { guild, channels, settings, stalePartners, bannerLicenses, panelClass, formatDate, issuedBannerKey, bannerError }) %>

    </main>
  </div>

  <script>
    window.dashboardSettings = <%- JSON.stringify(settings) %>;
    window.dashboardPlan = <%- JSON.stringify({ id: planId, allowFeatureToggle }) %>;
    window.dashboardCsrfToken = <%- JSON.stringify(csrfToken || '') %>;
  </script>
  <%- include('partials/footer') %>
