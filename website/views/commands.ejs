<%- include('partials/head', { title }) %>
<% const commandRows = Array.isArray(commands) ? commands : []; const planOptions = Array.isArray(plans) ? plans : []; %>
<body class="guide-page guide-commands-page">
  <header class="guide-nav">
    <a class="guide-brand" href="/guide">
      <span class="guide-brand-mark"><img src="/assets/HS.gif" alt="HS-Service 로고" /></span>
      <span><%= botName %> 명령어 안내</span>
    </a>
    <nav class="guide-nav-links" aria-label="주요 메뉴">
      <a href="/guide">플랜 가이드</a>
    </nav>
  </header>

  <main class="guide-shell guide-commands-shell">
    <a class="guide-back-link" href="/guide">← 플랜 가이드로 돌아가기</a>
    <section class="guide-commands-hero">
      <p class="guide-kicker">COMMAND REFERENCE · HS-SERVICE</p>
      <h1>명령어 안내</h1>
      <p>플랜을 선택하면 해당 플랜에서 사용할 수 있는 명령어와 기능 설명을 확인할 수 있습니다.</p>
    </section>

    <section class="guide-detail-section guide-commands-table-section">
      <div class="guide-section-heading guide-commands-heading">
        <div>
          <p class="guide-kicker">PLAN COMMANDS</p>
          <h2><span id="selected-plan-label">ENTERPRISE</span> 명령어</h2>
        </div>
        <label class="guide-plan-select-wrap" for="command-plan-select">
          <span>플랜 선택</span>
          <select id="command-plan-select" name="plan">
            <% planOptions.forEach((plan) => { const planValue = plan.slug || 'enterprise'; const planLabel = String(plan.label || 'Enterprise').toUpperCase(); %>
              <option value="<%= planValue %>"<% if (planValue === 'enterprise') { %> selected<% } %>><%= planLabel %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <p class="guide-command-result-summary"><strong id="visible-command-count">0</strong>개 명령어와 해당 플랜의 기능을 보여줍니다.</p>
      <div class="guide-command-table-wrap">
        <table class="guide-command-table">
          <thead>
            <tr>
              <th scope="col">명령어</th>
              <th scope="col">기능</th>
              <th scope="col">설명</th>
              <th scope="col">필요 권한</th>
            </tr>
          </thead>
          <tbody id="command-table-body">
            <% commandRows.forEach((command) => { const commandPlanIds = Array.isArray(command.planIds) ? command.planIds.join(',') : ''; %>
              <tr data-plan-ids="<%= commandPlanIds %>">
                <td><code>/<%= command.name %></code></td>
                <td><span class="guide-feature-tag"><%= command.feature %></span></td>
                <td><%= command.description %></td>
                <td><%= command.permission %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <p class="guide-command-empty" id="command-empty-state" hidden>선택한 플랜에서 사용할 수 있는 명령어가 없습니다.</p>
      </div>
    </section>
  </main>

  <script>
    (() => {
      const select = document.getElementById("command-plan-select");
      const label = document.getElementById("selected-plan-label");
      const count = document.getElementById("visible-command-count");
      const empty = document.getElementById("command-empty-state");
      const rows = [...document.querySelectorAll("#command-table-body tr")];
      const update = () => {
        const selectedId = select.value;
        const selectedLabel = select.options[select.selectedIndex].textContent;
        let visible = 0;
        rows.forEach((row) => {
          const matches = row.dataset.planIds.split(",").includes(selectedId);
          row.hidden = !matches;
          if (matches) visible += 1;
        });
        label.textContent = selectedLabel;
        count.textContent = visible;
        empty.hidden = visible !== 0;
      };
      select.addEventListener("change", update);
      update();
    })();
  </script>

  <%- include('partials/footer') %>
</body>
</html>
