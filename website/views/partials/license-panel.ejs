<section class="panel-stack <%= panelClass('license') %>" data-panel="license">
  <article class="card section-panel">
    <div class="section-head">
      <div>
        <p class="eyebrow">License Status</p>
        <h3>현재 라이선스 현황</h3>
      </div>
      <span class="status-pill <%= licenseStatus.activeCount ? 'is-active' : '' %>"><%= licenseStatus.activeCount ? '활성' : '확인 필요' %></span>
    </div>
    <p class="muted">현재 서버에 연결된 라이선스와 플랜별 사용 기간을 확인합니다.</p>

    <div class="grid two-up">
      <div class="metric-card">
        <span>연결된 라이선스</span>
        <strong><%= licenseStatus.licenses.length %>개</strong>
      </div>
      <div class="metric-card">
        <span>활성 라이선스</span>
        <strong><%= licenseStatus.activeCount %>개</strong>
      </div>
      <div class="metric-card">
        <span>현재 적용 플랜</span>
        <strong><%= plan.label %></strong>
      </div>
      <div class="metric-card">
        <span>가장 늦은 만료일</span>
        <strong><%= formatDate(licenseStatus.latestExpiresAt) %></strong>
      </div>
    </div>
  </article>

  <article class="card section-panel">
    <div class="section-head">
      <div>
        <p class="eyebrow">Connected Licenses</p>
        <h3>연결된 라이선스 목록</h3>
      </div>
    </div>
    <% if (licenseStatus.licenses.length) { %>
      <div class="data-list">
        <% for (const license of licenseStatus.licenses) { %>
          <div class="data-list-row">
            <div>
              <strong><%= String(license.plan || '').toUpperCase() %> 플랜</strong>
              <span class="muted">키 끝자리: <%= license.keyLast4 || '----' %> · 활성화: <%= formatDate(license.activatedAt) %></span>
            </div>
            <span class="muted"><%= license.status === 'active' ? '활성' : license.status === 'expired' ? '만료' : license.status === 'revoked' ? '폐기' : license.status %> · <%= formatDate(license.expiresAt) %></span>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <p class="muted">현재 서버에 연결된 서비스 라이선스가 없습니다.</p>
    <% } %>
  </article>
</section>
