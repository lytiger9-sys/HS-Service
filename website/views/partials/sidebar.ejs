<aside class="sidebar">
  <div class="brand">
    <span class="brand-kicker">HS Service</span>
    <h1><%= botName %></h1>
    <p><%= guild.name %></p>
  </div>

  <% if (currentUser) { %>
    <%- include('sidebar-user', { currentUser }) %>
  <% } %>

  <div class="sidebar-search">
    <label class="sidebar-search-field">
      <span class="sidebar-search-label">탭 검색</span>
      <input type="search" class="sidebar-search-input" placeholder="탭 이름이나 설명으로 검색" data-tab-search />
    </label>
    <div class="sidebar-search-results" data-tab-search-results hidden></div>
  </div>

  <nav class="sidebar-nav">
    <% sections.forEach((section, index) => { %>
      <button type="button" class="sidebar-tab <%= activeSection === section.id ? 'is-active' : '' %>" data-tab="<%= section.id %>">
        <span class="nav-index"><%= String(index + 1).padStart(2, "0") %></span>
        <span class="nav-copy">
          <strong class="nav-label"><%= section.label %></strong>
          <span class="nav-description"><%= section.description %></span>
        </span>
        <span class="nav-arrow">&rarr;</span>
      </button>
    <% }) %>
  </nav>
</aside>
