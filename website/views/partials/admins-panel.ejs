<article class="card section-panel">
  <div class="section-head">
    <div>
      <p class="eyebrow">Administrators</p>
      <h3>관리자 계정</h3>
    </div>
    <p class="muted">서버에서 관리자 권한을 가진 사용자 계정만 보여줍니다.</p>
  </div>

  <% if (administrators && administrators.length) { %>
    <div class="admin-list">
      <% administrators.forEach((admin) => { %>
        <div class="admin-card">
          <img class="admin-avatar" src="<%= admin.avatarUrl %>" alt="<%= admin.displayName %>" />
          <div class="admin-meta">
            <div class="admin-topline">
              <strong><%= admin.displayName %></strong>
              <span><%= admin.tag %></span>
            </div>
            <div class="admin-tags">
              <span class="chip">최고 역할: <%= admin.highestRole %></span>
              <span class="chip">가입: <%= formatDate(admin.joinedTimestamp) %></span>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p class="muted">표시할 사용자 관리자 계정이 없습니다.</p>
  <% } %>
</article>
