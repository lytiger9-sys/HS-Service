<article class="card section-panel">
  <div class="section-head">
    <div>
      <p class="eyebrow">Administrators</p>
      <h3>관리자 계정</h3>
    </div>
  </div>

  <% const staffList = (staffMembers && staffMembers.length ? staffMembers : administrators) || []; %>
  <% if (staffList.length) { %>
    <div class="admin-list">
      <% staffList.forEach((admin) => { %>
        <div class="admin-card">
          <img class="admin-avatar" src="<%= admin.avatarUrl %>" alt="<%= admin.displayName || admin.username || admin.tag %>" />
          <div class="admin-meta">
            <div class="admin-topline">
              <strong><%= admin.displayName || admin.username || admin.tag %></strong>
              <span><%= admin.username || admin.tag %></span>
            </div>
            <div class="admin-tags">
              <span class="chip">최고 역할: <%= admin.highestRole %></span>
              <span class="chip">가입: <%= formatDate(admin.joinedTimestamp) %></span>
            </div>
          </div>
          <% const isOnDuty = Boolean(admin.isOnDuty); %>
          <div class="admin-status">
            <span class="chip status-chip <%= isOnDuty ? 'is-on-duty' : 'is-off-duty' %>">
              <%= isOnDuty ? '출근' : '퇴근' %>
            </span>
            <span class="admin-status-note">
              <%= admin.statusUpdatedAt ? `업데이트: ${formatDate(admin.statusUpdatedAt)}` : '기본 상태' %>
            </span>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p class="muted">표시할 사용자 관리자 계정이 없습니다.</p>
  <% } %>

</article>
