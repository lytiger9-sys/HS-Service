<section class="panel-stack <%= panelClass('shop') %>" data-panel="shop">
  <article class="card section-panel shop-settings-card">
    <div class="section-head">
      <div><p class="eyebrow">Shop Economy</p><h3>상점 및 캐시 설정</h3></div>
      <label class="field toggle section-toggle"><input type="checkbox" form="shop-settings-form" name="shopEnabled" <%= shop.enabled !== false ? 'checked' : '' %> /><span>상점 기능 활성화</span></label>
    </div>
    <form class="settings-form" id="shop-settings-form" method="post" action="/guild/<%= guild.id %>/settings/shop">
      <div class="shop-setting-block">
        <div class="shop-setting-grid shop-top-settings">
          <label class="field"><span>상점 게시 채널</span><select name="shopMessageChannelId"><option value="">선택 안 함</option><% channels.text.forEach((channel) => { %><option value="<%= channel.id %>" <%= shop.messageChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option><% }) %></select></label>
          <label class="field"><span>출석 보상 캐시</span><input type="number" min="0" name="shopDailyReward" value="<%= shop.dailyReward %>" /></label>
          <label class="field"><span>메시지 보상 캐시</span><input type="number" min="0" name="shopMessageReward" value="<%= shop.messageReward %>" /></label>
          <label class="field"><span>메시지 보상 기준 개수</span><input type="number" min="1" name="shopMessageThreshold" value="<%= shop.messageThreshold %>" /></label>
        </div>
      </div>

      <div class="shop-setting-block shop-gambling-block">
        <div class="shop-subsection-head">
          <div><p class="eyebrow">Gambling</p><h4>도박</h4></div>
          <label class="field toggle shop-gambling-toggle"><input type="checkbox" name="shopGamblingEnabled" <%= shop.gamblingEnabled !== false ? 'checked' : '' %> /><span>도박 기능 활성화</span></label>
        </div>
        <div class="shop-setting-grid shop-gambling-settings">
          <label class="field"><span>도박 성공 확률(%)</span><input type="number" min="1" max="99" name="shopGamblingWinRate" value="<%= shop.gamblingWinRate %>" /></label>
          <label class="field"><span>도박 최대 금액</span><input type="number" min="1" name="shopGamblingMaxBet" value="<%= shop.gamblingMaxBet %>" /></label>
        </div>
      </div>

      <div class="shop-setting-block shop-embed-body-block">
        <div class="shop-subsection-head"><div><p class="eyebrow">Shop Embed</p><h4>상점 임베드 본문</h4></div></div>
        <label class="field full"><span>가운데 설명란</span><textarea name="shopEmbedBody" rows="5" maxlength="4000" placeholder="상점 임베드 가운데에 표시할 본문을 입력하세요."><%= shop.embedBody || '상품을 확인하거나 내 캐시 잔액을 확인하세요.' %></textarea></label>
        <div class="shop-embed-guide" role="note"><strong>사용 가능한 이미지 입력</strong><code>[Image] (이미지링크)</code><span>예: <code>[Image] (https://example.com/shop-banner.png)</code>를 한 줄에 입력하면 해당 위치에 이미지가 표시됩니다.</span></div>
      </div>

      <div class="form-actions"><button class="primary" type="submit">설정 저장</button><button class="ghost" type="submit" formaction="/guild/<%= guild.id %>/shop/publish">상점 임베드 게시</button></div>
    </form>
  </article>
  <article class="card section-panel">
    <div class="section-head"><div><p class="eyebrow">Vending Machine</p><h3>상품 관리</h3></div><button class="ghost" type="button" data-shop-add-product>상품 추가</button></div>
    <form method="post" action="/guild/<%= guild.id %>/shop/products" data-shop-products-form>
      <div class="shop-product-list" data-shop-product-list>
        <% (shop.products || []).forEach((product) => { %>
          <div class="shop-product-row" data-shop-product>
            <input type="hidden" name="productId" value="<%= product.id %>" />
            <label class="field"><span>상품명</span><input name="productName" value="<%= product.name %>" required /></label>
            <label class="field"><span>가격</span><input type="number" min="0" name="productPrice" value="<%= product.price %>" required /></label>
            <label class="field full"><span>상품 설명</span><input name="productDescription" value="<%= product.description %>" /></label>
            <label class="field full"><span>재고 내용(한 줄당 1개)</span><textarea name="productDelivery" rows="5" required placeholder="재고 1\n재고 2\n재고 3"><%= product.stock ? product.stock.join('\n') : product.delivery %></textarea><small class="muted">줄바꿈마다 재고 1개로 저장되며, 구매 시 위에서부터 하나씩 DM으로 전달됩니다.</small></label>
            <label class="field toggle"><input type="checkbox" name="productEnabled" value="<%= product.id %>" <%= product.enabled !== false ? 'checked' : '' %> /><span>판매 중</span></label>
            <button class="ghost danger" type="button" data-shop-remove-product>삭제</button>
          </div>
        <% }) %>
      </div>
      <button class="primary" type="submit">상품 저장</button>
    </form>
  </article>
</section>
