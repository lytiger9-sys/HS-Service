<section class="panel-stack <%= panelClass('partner') %>" data-panel="partner">
  <article class="card section-panel">
    <div class="section-head">
      <div>
        <p class="eyebrow">Partner</p>
        <h3>파트너 설정</h3>
      </div>
      <label class="field toggle section-toggle">
        <input type="checkbox" form="partner-settings-form" name="partnerEnabled" <%= settings.partner.enabled ? 'checked' : '' %> />
        <span>파트너 기능 활성화</span>
      </label>
    </div>
    <form class="settings-form" id="partner-settings-form" method="post" action="/guild/<%= guild.id %>/settings/partner">
      <div class="form-grid">
        <label class="field"><span>파트너 조건 채널</span><select name="partnerConditionsChannelId"><option value="">선택 안 함</option><% channels.text.forEach((channel) => { %><option value="<%= channel.id %>" <%= settings.partner.conditionsChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option><% }) %></select></label>
        <label class="field"><span>파트너 승인 채널</span><select name="partnerApprovalChannelId"><option value="">선택 안 함</option><% channels.text.forEach((channel) => { %><option value="<%= channel.id %>" <%= settings.partner.approvalChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option><% }) %></select></label>
        <label class="field"><span>파트너 카테고리</span><select name="partnerCategoryId"><option value="">선택 안 함</option><% channels.categories.forEach((channel) => { %><option value="<%= channel.id %>" <%= settings.partner.partnerCategoryId === channel.id ? 'selected' : '' %>><%= channel.label %></option><% }) %></select></label>
        <label class="field"><span>채널 접두사</span><input name="partnerNamePrefix" value="<%= settings.partner.namePrefix %>" maxlength="30" /></label>
        <label class="field"><span>채널 접미사</span><input name="partnerNameSuffix" value="<%= settings.partner.nameSuffix %>" maxlength="30" /></label>
        <label class="field"><span>채널 이모지</span><input name="partnerNameEmoji" value="<%= settings.partner.nameEmoji %>" maxlength="8" /></label>
        <label class="field"><span>임베드 제목</span><input name="partnerEmbedTitle" value="<%= settings.partner.embedTitle %>" data-partner-preview="title" /></label>
        <label class="field full"><span>임베드 내용</span><textarea name="partnerEmbedDescription" rows="4" data-partner-preview="description"><%= settings.partner.embedDescription %></textarea></label>
        <label class="field"><span>임베드 색상</span><input type="color" name="partnerEmbedColor" value="<%= settings.partner.embedColor %>" data-partner-preview="color" /></label>
        <label class="field"><span>버튼 이름</span><input name="partnerButtonLabel" value="<%= settings.partner.buttonLabel %>" data-partner-preview="button" /></label>
      </div>
      <button class="primary" type="submit">파트너 설정 저장 및 임베드 동기화</button>
    </form>
  </article>

  <article class="card section-panel">
    <div class="section-head banner-section-head"><div><p class="eyebrow">Banner</p><h3>상단배너 설정</h3></div><label class="field toggle section-toggle banner-toggle"><input type="checkbox" form="partner-settings-form" name="bannerEnabled" <%= settings.partner.banner.enabled ? 'checked' : '' %> /><span>상단배너 기능 활성화</span></label></div>
    <div class="form-grid">
      <label class="field"><span>배너 임베드 채널</span><select name="bannerChannelId" form="partner-settings-form"><option value="">선택 안 함</option><% channels.text.forEach((channel) => { %><option value="<%= channel.id %>" <%= settings.partner.banner.channelId === channel.id ? 'selected' : '' %>><%= channel.label %></option><% }) %></select></label>
      <label class="field"><span>배너 카테고리</span><select name="bannerCategoryId" form="partner-settings-form"><option value="">선택 안 함</option><% channels.categories.forEach((channel) => { %><option value="<%= channel.id %>" <%= settings.partner.banner.categoryId === channel.id ? 'selected' : '' %>><%= channel.label %></option><% }) %></select></label>
      <label class="field"><span>배너 접두사</span><input form="partner-settings-form" name="bannerNamePrefix" value="<%= settings.partner.banner.namePrefix %>" /></label>
      <label class="field"><span>배너 접미사</span><input form="partner-settings-form" name="bannerNameSuffix" value="<%= settings.partner.banner.nameSuffix %>" /></label>
      <label class="field"><span>배너 이모지</span><input form="partner-settings-form" name="bannerNameEmoji" value="<%= settings.partner.banner.nameEmoji %>" /></label>
      <label class="field"><span>배너 제목</span><input form="partner-settings-form" name="bannerEmbedTitle" value="<%= settings.partner.banner.embedTitle %>" /></label>
      <label class="field full"><span>배너 내용</span><textarea form="partner-settings-form" name="bannerEmbedDescription" rows="3"><%= settings.partner.banner.embedDescription %></textarea></label>
      <label class="field"><span>배너 색상</span><input type="color" form="partner-settings-form" name="bannerEmbedColor" value="<%= settings.partner.banner.embedColor %>" /></label>
      <label class="field"><span>배너 버튼 이름</span><input form="partner-settings-form" name="bannerButtonLabel" value="<%= settings.partner.banner.buttonLabel %>" /></label>
    </div>
    <div class="form-actions">
      <button class="primary" type="submit" form="partner-settings-form">상단배너 설정 저장</button>
    </div>
  </article>

  <article class="card section-panel" data-partial-target="partner-cleanup">
    <div class="section-head"><div><p class="eyebrow">Cleanup</p><h3>7일 이상 비활성 파트너</h3></div><span class="muted"><%= stalePartners.length %>개</span></div>
    <div class="table-wrap"><table><thead><tr><th>제휴명</th><th>채널</th><th>마지막 활동</th><th>신청자</th><th>관리</th></tr></thead><tbody>
      <% if (!stalePartners.length) { %><tr><td colspan="5" class="muted">정리할 비활성 파트너가 없습니다.</td></tr><% } %>
      <% stalePartners.forEach((partner) => { %><tr><td><%= partner.affiliateName %></td><td><%= partner.channelId %></td><td><%= formatDate(partner.lastMessageAt || partner.approvedAt) %></td><td><%= partner.requesterTag || partner.requesterId %></td><td><form method="post" action="/guild/<%= guild.id %>/partner/<%= partner.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="ghost danger" type="submit">채널 삭제</button></form></td></tr><% }) %>
    </tbody></table></div>
  </article>

  <article class="card section-panel banner-license-card">
    <div class="section-head"><div><p class="eyebrow">License</p><h3>배너 라이선스 발급</h3></div></div>
    <div data-partial-target="banner-license-result">
      <% if (bannerError) { %><p class="notice danger"><%= bannerError %></p><% } %>
      <% if (issuedBannerKey) { %><p class="notice success"><strong>배너 라이선스가 발급되었습니다.</strong><br /><code><%= issuedBannerKey %></code><br /><span class="muted">이 키를 배너를 받을 서버 관리자에게 전달하세요. 발급된 키는 아래 ‘발급한 상단배너 라이센스’ 목록에서 계속 확인할 수 있습니다.</span></p><% } %>
    </div>
    <form class="settings-form banner-license-issue-form" method="post" action="/guild/<%= guild.id %>/partner/banner-license">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="form-grid"><label class="field"><span>사용 기간(일)</span><input type="number" name="bannerDurationDays" min="1" max="3650" value="30" required /></label></div>
      <button class="primary" type="submit">배너 라이선스 발급</button>
    </form>
  </article>

  <article class="card section-panel banner-license-list-card<%= bannerLicenses && bannerLicenses.length ? '' : ' is-hidden' %>" data-partial-target="banner-license-list">
      <div class="section-head"><div><p class="eyebrow">Issued Banner Licenses</p><h3>발급한 상단배너 라이센스</h3><p class="muted">상단배너 라이센스는 이 파트너 탭에서만 확인합니다.</p></div><span class="muted"><%= bannerLicenses.length %>개</span></div>
      <div class="table-wrap"><table><thead><tr><th>라이센스 키</th><th>상태</th><th>수령 서버</th><th>만료일</th></tr></thead><tbody>
        <% if (!bannerLicenses || !bannerLicenses.length) { %><tr><td colspan="4" class="muted">발급한 상단배너 라이선스가 없습니다.</td></tr><% } %>
        <% (bannerLicenses || []).forEach((license) => { %><tr><td><code><%= license.key || `HS-••••-••••-${license.keyLast4}` %></code></td><td><span class="status-badge status-<%= license.status %>"><%= license.status %></span></td><td><%= license.assignedGuildId || '-' %></td><td><%= license.expiresAt ? new Date(license.expiresAt).toLocaleString('ko-KR') : '-' %></td></tr><% }) %>
      </tbody></table></div>
    </article>
</section>
