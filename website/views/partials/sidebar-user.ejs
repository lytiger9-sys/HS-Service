<% const selectableGuilds = (managedGuilds || []).filter((managedGuild) => managedGuild.botPresent && managedGuild.licenseActive); %>
<div class="sidebar-user-row">
  <img class="user-avatar" src="<%= currentUser.avatarUrl %>" alt="<%= currentUser.displayName %>" draggable="false" />
  <div class="sidebar-user-copy">
    <span class="sidebar-user-kicker">Signed in</span>
    <strong><%= currentUser.displayName %></strong>
    <span><%= currentUser.tag %></span>
  </div>
</div>

<a class="sidebar-logout" href="/auth/logout">로그아웃</a>

<label class="sidebar-server-picker">
  <span>등록 서버 선택</span>
  <select data-server-picker aria-label="등록 서버 선택">
    <option value="">서버를 선택하세요</option>
    <% selectableGuilds.forEach((managedGuild) => { %>
      <option value="<%= managedGuild.id %>" <%= currentGuildId === managedGuild.id ? 'selected' : '' %>><%= managedGuild.name %></option>
    <% }) %>
  </select>
</label>

<script>
  (() => {
    const picker = document.querySelector('[data-server-picker]');
    if (!picker) return;
    picker.addEventListener('change', () => {
      if (picker.value) window.location.href = `/?guildId=${encodeURIComponent(picker.value)}`;
    });
  })();
</script>
