<section class="panel-stack <%= typeof panelClass === 'function' ? panelClass('logs') : '' %>" data-panel="logs">
  <article class="card section-panel">
    <div class="section-head">
      <div>
        <p class="eyebrow">Logs</p>
        <h3>로그 채널</h3>
      </div>
      <label class="field toggle section-toggle">
        <input type="checkbox" form="logs-settings-form" name="logsEnabled" <%= settings.logs.enabled !== false ? 'checked' : '' %> />
        <span>로그 기능 활성화</span>
      </label>
    </div>

    <form class="settings-form" id="logs-settings-form" method="post" action="/guild/<%= guild.id %>/settings/logs">
      <div class="form-grid">
        <label class="field">
          <span>모더레이션 로그</span>
          <select name="logModerationChannelId">
            <option value="">선택 안 함</option>
            <% channels.text.forEach((channel) => { %>
              <option value="<%= channel.id %>" <%= settings.logs.moderationChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
            <% }) %>
          </select>
        </label>
        <label class="field">
          <span>보안 로그</span>
          <select name="logSecurityChannelId">
            <option value="">선택 안 함</option>
            <% channels.text.forEach((channel) => { %>
              <option value="<%= channel.id %>" <%= settings.logs.securityChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
            <% }) %>
          </select>
        </label>
        <label class="field">
          <span>서버 로그</span>
          <select name="logServerChannelId">
            <option value="">선택 안 함</option>
            <% channels.text.forEach((channel) => { %>
              <option value="<%= channel.id %>" <%= settings.logs.serverChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
            <% }) %>
          </select>
        </label>
        <label class="field">
          <span>투표 로그</span>
          <select name="logVoteChannelId">
            <option value="">선택 안 함</option>
            <% channels.text.forEach((channel) => { %>
              <option value="<%= channel.id %>" <%= settings.logs.voteChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
            <% }) %>
          </select>
        </label>
        <label class="field">
          <span>시스템 로그</span>
          <select name="logSystemChannelId">
            <option value="">선택 안 함</option>
            <% channels.text.forEach((channel) => { %>
              <option value="<%= channel.id %>" <%= settings.logs.systemChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <button class="primary" type="submit">저장</button>
    </form>
  </article>
</section>
