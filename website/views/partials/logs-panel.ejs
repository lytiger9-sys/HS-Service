<section class="panel-stack <%= typeof panelClass === 'function' ? panelClass('logs') : '' %>" data-panel="logs">
  <article class="card section-panel">
    <div class="section-head">
      <div>
        <p class="eyebrow">Server Logs</p>
        <h3>서버 로그</h3>
        <p class="muted">서버 활동 로그를 하나의 채널로 통합하고 표시할 분야를 선택합니다.</p>
      </div>
      <label class="field toggle section-toggle">
        <input type="checkbox" form="logs-settings-form" name="logsEnabled" <%= settings.logs.enabled !== false ? 'checked' : '' %> />
        <span>서버 로그 활성화</span>
      </label>
    </div>
    <form class="settings-form" id="logs-settings-form" method="post" action="/guild/<%= guild.id %>/settings/logs">
      <div class="form-grid">
        <label class="field full"><span>서버 로그 채널</span><select name="logServerChannelId"><option value="">선택 안 함</option><% channels.text.forEach((channel) => { %><option value="<%= channel.id %>" <%= settings.logs.serverChannelId === channel.id ? 'selected' : '' %>><%= channel.label %></option><% }) %></select></label>
        <label class="field toggle"><input type="checkbox" name="logServerNameChangeEnabled" <%= settings.logs.serverNameChangeEnabled !== false ? 'checked' : '' %> /><span>서버 이름 변경</span></label>
        <label class="field toggle"><input type="checkbox" name="logMessageChangeEnabled" <%= settings.logs.messageChangeEnabled !== false ? 'checked' : '' %> /><span>메시지 수정·삭제</span></label>
        <label class="field toggle"><input type="checkbox" name="logCategoryChangeEnabled" <%= settings.logs.categoryChangeEnabled !== false ? 'checked' : '' %> /><span>카테고리 추가·수정·삭제</span></label>
        <label class="field toggle"><input type="checkbox" name="logChannelChangeEnabled" <%= settings.logs.channelChangeEnabled !== false ? 'checked' : '' %> /><span>채널 추가·수정·삭제</span></label>
        <label class="field toggle"><input type="checkbox" name="logGuildBrandingChangeEnabled" <%= settings.logs.guildBrandingChangeEnabled !== false ? 'checked' : '' %> /><span>서버 이름·아이콘·배너 변경</span></label>
        <label class="field toggle"><input type="checkbox" name="logModerationActionEnabled" <%= settings.logs.moderationActionEnabled !== false ? 'checked' : '' %> /><span>유저 타임아웃·서버 차단·제재 이유</span></label>
      </div>
      <button class="primary" type="submit">저장</button>
    </form>
  </article>
</section>
